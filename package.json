{
	"name": "honomiya",
	"version": "0.2.0",
	"description": "Command-line toolkit for synchronizing ebooks with audiobooks.",
	"private": true,
	"type": "module",
	"bin": {
		"honomiya": "./src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./manifest": "./src/artifacts/manifest.ts"
	},
	"scripts": {
		"honomiya": "bun run ./src/cli.ts",
		"build": "bun build ./src/cli.ts --target=bun --outdir=dist && cp ./src/transcription/providers/local-worker.py ./dist/local-worker.py",
		"check-types": "tsc --noEmit",
		"test": "bun test src",
		"validate": "bun run check-types && bun test src && bun run build"
	},
	"dependencies": {
		"7z-wasm": "^1.2.0",
		"cheerio": "^1.2.0",
		"fast-xml-parser": "^5.10.1",
		"fflate": "^0.8.3",
		"modal": "0.9.0",
		"node-stream-zip": "^1.16.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.14"
}
